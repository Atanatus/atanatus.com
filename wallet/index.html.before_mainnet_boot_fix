<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  >

  <title>ATANATUS Â· Wallet</title>

  <meta
    name="description"
    content="ATANATUS Wallet â€” non-custodial Bitcoin Cash and ATAN wallet."
  >

  <link
    rel="icon"
    href="./ATAN_LOGO_OFICIAL.png"
  >

  <link
    rel="apple-touch-icon"
    href="./ATAN_LOGO_OFICIAL.png"
  >

  <link
    rel="stylesheet"
    href="./styles.css"
  >

  <script type="importmap">
  {
    "imports": {
      "@scure/bip39": "/vendor/@scure/bip39/index.js",
      "@scure/bip39/": "/vendor/@scure/bip39/",
      "@scure/bip32": "/vendor/@scure/bip32/index.js",
      "@scure/base": "/vendor/@scure/base/index.js",
      "@scure/base/": "/vendor/@scure/base/",
      "@noble/hashes/": "/vendor/@noble/hashes/",
      "@noble/curves/": "/vendor/@noble/curves/"
    }
  }
  </script>
  <meta name="atan-wallet-release" content="ATAN_WALLET_STATIC_V1">
</head>

<body>

  <div class="shell">

    <header class="topbar">

      <a
        class="brand"
        href="https://atanatus.com/"
      >
        <img
          src="./ATAN_LOGO_OFICIAL.png"
          alt="ATANATUS"
        >

        <span>
          <strong>ATANATUS</strong>
          <small>WALLET</small>
        </span>
      </a>

      <div class="network-state">
        <span class="dot"></span>
        <span>Bitcoin Cash Â· Mainnet</span>
        <span id="height">â€”</span>
      </div>

    </header>


    <main>

      <section class="hero">

        <div>
          <div class="eyebrow">
            NON-CUSTODIAL Â· CLIENT-ONLY KEYS
          </div>

          <h1>
            Your BCH.
            <span>Your ATAN.</span>
          </h1>

          <p>
            Recovery words are processed locally for derivation.
            ATANATUS never receives your recovery phrase
            or private key.
          </p>
        </div>

        <div
          id="globalStatus"
          class="status"
        >
          Connecting to BCH mainnetâ€¦
        </div>

      </section>


      <section
        id="lockedView"
        class="wallet-gate"
      >

        <article class="panel">

          <div class="panel-label">
            NEW WALLET
          </div>

          <h2>Create locally</h2>

          <p>
            Generate a new 12-word Bitcoin Cash wallet
            entirely in your browser.
          </p>

          <button
            id="createWallet"
            class="primary"
            type="button"
          >
            Create wallet
          </button>

        </article>


        <article class="panel">

          <div class="panel-label">
            RECOVERY
          </div>

          <h2>Open existing wallet</h2>

          <p>
            Enter your 12 recovery words.
            They are processed locally.
          </p>

          <textarea
            id="mnemonicInput"
            rows="4"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            data-1p-ignore
            data-lpignore="true"
            placeholder="12 recovery words"
          ></textarea>

          <button
            id="recoverWallet"
            class="secondary"
            type="button"
          >
            Open wallet
          </button>

        </article>

      </section>


      <section
        id="recoveryView"
        class="recovery-panel"
        hidden
      >

        <div class="panel-label">
          RECOVERY PHRASE Â· SHOWN LOCALLY
        </div>

        <h2>Write these 12 words down</h2>

        <p>
          Anyone with these words controls this wallet.
          ATANATUS does not store them.
        </p>

        <div
          id="generatedMnemonic"
          class="mnemonic"
        ></div>

        <button
          id="hideRecovery"
          class="secondary"
          type="button"
        >
          I saved the words
        </button>

      </section>


      <section
        id="walletView"
        hidden
      >

        <div class="wallet-header">

          <div>
            <div class="eyebrow">
              ACTIVE WALLET
            </div>

            <button
              id="walletAddress"
              class="address"
              type="button"
              title="Copy address"
            >
              â€”
            </button>

            <div class="token-address-label">
              ATAN / CashTokens receive address
            </div>

            <button
              id="tokenAddress"
              class="address token-address"
              type="button"
              title="Copy CashTokens address"
            >
              â€”
            </button>
          </div>

          <div class="wallet-actions">

            <button
              id="refreshWallet"
              class="secondary"
              type="button"
            >
              Refresh
            </button>

            <button
              id="lockWallet"
              class="ghost"
              type="button"
            >
              Lock
            </button>

          </div>

        </div>


        <section class="balances">

          <article class="balance-card">

            <div class="asset">
              BCH
            </div>

            <strong id="bchBalance">
              â€”
            </strong>

            <small>
              Bitcoin Cash
            </small>

          </article>


          <article class="balance-card">

            <div class="asset accent">
              ATAN
            </div>

            <strong id="atanBalance">
              â€”
            </strong>

            <small>
              Atanatus
            </small>

          </article>

        </section>


        <section class="quick-actions">

          <button
            id="copyReceive"
            class="primary"
            type="button"
          >
            Receive BCH
          </button>

          <button
            id="copyTokenReceive"
            class="secondary"
            type="button"
          >
            Receive ATAN
          </button>

          <button
            id="sendOpen"
            class="secondary"
            type="button"
          >
            Send
          </button>

        </section>


        <section
          id="sendPanel"
          class="send-panel"
          hidden
        >

          <div class="panel-label">
            SEND · CLIENT-SIDE SIGNING
          </div>

          <h2>Send BCH or ATAN</h2>

          <p class="send-note">
            Your private key never leaves this browser.
            Review the transaction before broadcasting.
          </p>

          <div class="send-grid">

            <label>
              Asset
              <select id="sendAsset">
                <option value="BCH">BCH</option>
                <option value="ATAN">ATAN</option>
              </select>
            </label>

            <label>
              Recipient
              <input
                id="sendRecipient"
                type="text"
                autocomplete="off"
                spellcheck="false"
                placeholder="bitcoincash:..."
              >
            </label>

            <label>
              Amount
              <input
                id="sendAmount"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="0.00000000"
              >
            </label>

          </div>

          <div class="send-actions">

            <button
              id="sendPrepare"
              class="primary"
              type="button"
            >
              Review transaction
            </button>

            <button
              id="sendCancel"
              class="ghost"
              type="button"
            >
              Cancel
            </button>

          </div>

          <div
            id="sendReview"
            class="send-review"
            hidden
          >

            <pre id="sendReviewText"></pre>

            <button
              id="sendBroadcast"
              class="primary"
              type="button"
              disabled
            >
              Broadcast transaction
            </button>

          </div>

          <div
            id="sendResult"
            class="send-result"
            hidden
          ></div>

        </section>

<section class="field">

          <div class="field-head">

            <div>
              <div class="panel-label">
                ATAN FIELD
              </div>

              <h2>
                Contribution Field
              </h2>
            </div>

            <span
              id="fieldState"
              class="field-pill"
            >
              â€”
            </span>

          </div>


          <div class="field-grid">

            <div>
              <span>Snapshot balance</span>
              <strong id="fieldBalance">â€”</strong>
            </div>

            <div>
              <span>Requirement</span>
              <strong>100,000 ATAN</strong>
            </div>

            <div>
              <span>Eligibility</span>
              <strong id="fieldEligibility">â€”</strong>
            </div>

            <div>
              <span>Daily allocation</span>
              <strong id="fieldReward">5.21481084 ATAN</strong>
            </div>

            <div>
              <span>Next snapshot</span>
              <strong>02:00 Â· Europe/Madrid</strong>
            </div>

            <div>
              <span>Latest entitlement</span>
              <strong id="fieldEntitlement">â€”</strong>
            </div>

          </div>

          <div
            id="fieldSnapshot"
            class="field-foot"
          >
            â€”
          </div>

        </section>


        <section class="activity">

          <div class="panel-label">
            ACTIVITY
          </div>

          <div class="activity-row">

            <span>
              Mainnet wallet
            </span>

            <strong>
              BCH + ATAN wallet
            </strong>

          </div>

          <p>
            Sending remains deliberately disabled until
            the BCH mainnet signing path is separately
            certified.
          </p>

        </section>

      </section>

    </main>


    <footer>

      <span>
        NON OMNIS MORIAR
      </span>

      <span>
        ATANATUS Â· Bitcoin Cash
      </span>

    </footer>

  </div>


  

  <script src="./vendor/mainnet-3.1.9.js"></script>
  <script type="module" src="./app.mjs"></script>
</body>
</html>